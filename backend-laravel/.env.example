# Nilai contoh untuk dev lokal. Salin ke .env (tidak dilacak git) lalu
# sesuaikan. Env yang sudah ada di shell selalu menang atas isi .env.
#
# Nama env ini sama di semua varian backend bengkel (lihat "Env bersama
# backend" di spec/openapi.yaml). Env khas Laravel (APP_KEY, APP_ENV,
# LOG_CHANNEL, DB_*) tidak dipakai; semua pengaturan Laravel yang dibutuhkan
# sudah tertulis di folder config/. Semua nilai di bawah hanya untuk laptop:
# kredensial MySQL milik kontainer lokal (docker compose), dan token WhatsApp
# hanya dikenal WhatsApp palsu.

# Semua nilai dipangkas (spasi, tab, CR, LF di awal dan akhir); nilai yang
# kosong sesudah dipangkas dianggap tidak diisi.

# Port server (wajib). Port dev bawaan varian Laravel.
PORT=8802

# mysql://user:sandi@host:port/database (wajib). Karakter khusus di sandi
# ditulis dengan escape URL, mis. @ menjadi %40. Tulis 127.0.0.1, bukan
# localhost: di Windows PHP butuh ±2 detik di setiap koneksi hanya untuk
# menerjemahkan nama localhost.
DATABASE_URL=mysql://bengkel:bengkel@127.0.0.1:3350/bengkel

# Token sekali pakai untuk membuat akun pemilik pertama lewat halaman
# pemasangan awal (POST /api/setup). Hanya berlaku selama belum ada akun
# staf sama sekali. Kosong = pemasangan dimatikan (403). Bila diisi, minimal
# 16 byte; pakai nilai acak sendiri, mis. hasil `openssl rand -hex 16` (juga
# di laptop), buat akun pemilik, lalu kosongkan lagi. Nilai contoh dari
# dokumentasi ditolak saat backend menyala.
SETUP_TOKEN=

# Penyedia WhatsApp untuk pesan booking, SPK, siap diambil, dan nota (wajib).
# WA_API_URL adalah alamat kirim LENGKAP dengan path; backend mengirim POST
# ke alamat itu apa adanya. Nilai di bawah untuk WhatsApp palsu
# (tests/wa-palsu), yang menampilkan semua pesan di http://localhost:8890.
# Untuk Fonnte: WA_API_URL=https://api.fonnte.com/send dan WA_TOKEN = token
# perangkat dari dashboard (tanpa "Bearer"). Jangan menulis token asli di
# berkas ini.
WA_API_URL=http://localhost:8890/send
WA_TOKEN=token-wa-uji-bengkel-bukan-kunci-asli

# Alamat website publik (web Next.js) untuk merangkai tautan di pesan
# WhatsApp, mis. http://localhost:3800/servis/<token> (wajib). Diawali
# http:// atau https://; garis miring di akhir dibuang.
PUBLIC_WEB_URL=http://localhost:3800
