{
  "name": "bengkel-tes-kontrak",
  "version": "0.0.0",
  "private": true,
  "description": "Tes kontrak API aplikasi bengkel, dijalankan sama persis terhadap backend Laravel, Go, dan NestJS",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint-spec": "redocly lint ../../spec/openapi.yaml --config ../../spec/redocly.yaml",
    "bundel-spec": "tsx src/bundel-spec.ts",
    "cek-harness": "tsx src/cek-harness.ts"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.20",
    "@redocly/openapi-core": "1.34.20",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bcryptjs": "3.0.3",
    "mysql2": "3.24.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
