# Salin ke .env (tidak dilacak git) bila tidak ingin menulis env di setiap
# perintah. Env dari shell selalu menang atas isi .env. Semua nilai di bawah
# palsu dan hanya untuk uji lokal.

# Wajib: alamat backend yang diuji. 8881 = Go, 8882 = Laravel, 8883 = NestJS.
BASE_URL=http://localhost:8882

# Opsional. Bila tidak diisi dan BASE_URL memakai port 8881/8882/8883,
# harness memakai database uji dan WhatsApp palsu milik backend itu:
#   8881 → bengkel_uji + 8891, 8882 → bengkel_uji_laravel + 8892, 8883 → bengkel_uji_nestjs + 8893.
# Hanya bengkel_uji dan bengkel_uji_<nama> yang diterima (semua tabelnya dikosongkan).
# DATABASE_URL=mysql://bengkel:bengkel@127.0.0.1:3350/bengkel_uji_laravel
# WA_PALSU_URL=http://localhost:8892

# Tiga nilai berikut wajib sama dengan env backend yang diuji.
WA_TOKEN=token-wa-uji-bengkel-bukan-kunci-asli
SETUP_TOKEN=token-setup-uji-bengkel-bukan-rahasia
PUBLIC_WEB_URL=http://localhost:3880

# Lama menunggu GET /api/health sebelum menyerah (detik).
TUNGGU_BACKEND_DETIK=30
