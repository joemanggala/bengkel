# Nilai contoh; main.ts membaca env shell. Backend dev mengirim ke
# WA_API_URL=http://localhost:8890/send dengan WA_TOKEN yang sama seperti di bawah.
WA_PALSU_PORT=8890
# Isi header Authorization yang diterima. Nilai ini palsu dan hanya untuk lokal.
WA_TOKEN=token-wa-uji-bengkel-bukan-kunci-asli
