# Alamat backend; nilai di bawah adalah port dev bawaan backend Laravel. Hanya dibaca server
# Next.js, jadi sengaja tanpa awalan NEXT_PUBLIC_: browser tidak pernah berbicara langsung dengan
# backend, semua panggilan dari browser lewat route handler /bff/*.
# Saat pengembangan, bila kosong, dipakai http://localhost:8802. Di produksi wajib diisi.
API_URL=http://localhost:8802

# Alamat website yang dibuka pelanggan, SAMA dengan PUBLIC_WEB_URL backend. Dipakai menyusun tautan
# lacak di nota cetak dan tombol Salin/Buka di rincian SPK, supaya sama persis dengan tautan di pesan
# WhatsApp ({PUBLIC_WEB_URL}/servis/<token>). Hanya dibaca server, saat berjalan (bukan saat build).
# Wajib diawali http:// atau https:// tanpa spasi; garis miring di akhir dibuang. Saat
# pengembangan, bila kosong, dipakai alamat browser (dengan catatan di layar). Di produksi wajib
# diisi, mis. https://bengkelku.id.
PUBLIC_WEB_URL=http://localhost:3800

# Opsional. Kosong = atribut Secure cookie sesi mengikuti protokol permintaan (https -> Secure,
# http -> tanpa Secure, supaya tablet kasir di jaringan lokal lewat http:// tetap bisa masuk).
# Isi true di produksi yang memakai HTTPS.
COOKIE_SECURE=
